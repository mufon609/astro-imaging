requires 1.4.0
set32bits
setcompress 0
setext fit
cd /home/samsung/Desktop/astro-imaging/datasets/aug06/set-03/union_ab/B_astro/in
link s -out=/home/samsung/Desktop/astro-imaging/datasets/aug06/set-03/union_ab/B_astro/seq
cd /home/samsung/Desktop/astro-imaging/datasets/aug06/set-03/union_ab/B_astro/seq
seqplatesolve s
setref s 1
seqapplyreg s -framing=max -prefix=r_
stack r_s_ mean none -norm=addscale -output_norm -weight=nbstack -out=/home/samsung/Desktop/astro-imaging/datasets/aug06/set-03/union_ab/UNION_B_astro
