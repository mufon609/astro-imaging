requires 1.4.0
setcompress 0
setext fit
# 32-bit: a master dark is the MEAN of many frames, so its precision is far
# finer than one integer step, and 16-bit storage throws that away as a
# SENSOR-FIXED pattern subtracted identically into every light — the input to
# walking noise. MEASURED on a 200-frame dark: 16-bit quantization injects
# 0.2889 ADU RMS (uniform +-0.5, matching 1/sqrt(12)=0.2887) against a
# statistical floor of 0.4213 ADU, inflating the master's fixed-pattern
# residual 0.4213 -> 0.5109 ADU, i.e. +21%.
set32bits
cd darks
convert dark -out=../work
cd ../work
stack dark rej 3 3 -nonorm -out=masters/dark_master
close
