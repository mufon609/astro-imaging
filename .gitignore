# This repo tracks the PROCESS (scripts + docs), never image data. Raw frames,
# FITS/XISF intermediates, and stacked products are large and live OFF-REPO
# (backed up separately). Only per-dataset STATE (small JSON under
# datasets/<session>/<set>/) is versioned — see datasets/README.md.

# --- image data: raw frames, intermediates, products (any dir) ---
*.dng
*.DNG
*.nef
*.NEF
*.cr2
*.CR2
*.cr3
*.CR3
*.arw
*.ARW
*.raf
*.RAF
*.fit
*.fits
*.fts
*.xisf
*.ser
*.seq
*.tif
*.tiff
**/work/
**/results/

# --- anomaly-audit scratch ---
# audit_work/ (under datasets/<session>/<set>/) holds transient Siril working
# files — residual TIFFs, star lists, the .ssf, extracted-green FITS. ONLY the
# anomaly_audit.json record it contains is versioned; the rest is regenerated.
**/audit_work/*
!**/audit_work/anomaly_audit.json

# --- ingest scratch ---
# ingest_work/ (under datasets/<session>/<set>/) holds the pulled unit manifest
# and the sha256sum -c report. Only ingest.json — the transfer record — is
# versioned; the manifest and report are regenerated by re-running the fetch.
**/ingest_work/*
!**/ingest_work/ingest.json

# --- judgment surfaces (image data, never tracked) ---
**/judge/

# --- QA / calibration scratch ---
# qa_work/ (under datasets/<session>/<set>/) holds transient Siril working files
# (CFA FITS / .seq / .ssf / previews / logs). Only its .json records are versioned
# (frame_metrics.json, skyflat_qa.json, …); the rest is regenerated.
**/qa_work/*
!**/qa_work/*.json

# --- session data dirs (transient staging) ---
# Every acquisition session lives under sessions/<session>/ (raw lights +
# calibration + work/ intermediates). NEVER committed — one structural rule
# covers all sessions, no per-session entry needed.
#
# THIRD-PARTY practice corpora especially must never be committed or
# redistributed — download and PROCESS only, link the source (terms vary: some
# are CC-BY-NC-SA / no-redistribute). Record each one's source + license in a
# comment here when one is staged.
/sessions/

# --- durable outputs (web-servable, image data — never tracked) ---
# web/ itself is TRACKED (the front-end code + assets); its results/ data
# tree is not. The `**/results/` pattern above already ignores web/results/;
# this line makes the contract explicit.
/web/results/

# --- vendor tool payloads staged at the repo root ---
# Downloaded installer archives + model weights. Multi-GB binaries and image
# data: never committed, never redistributed (vendor licences vary). The tool
# itself installs to /opt and is recorded in scripts/setup/manifest.tsv — this
# dir is only the staging area the archives were fetched into.
/cosmic/

# --- tooling / OS cruft ---
__pycache__/
*.pyc
.DS_Store

# --- root-level images are working screenshots (judgment surfaces), never data ---
/*.png
/*.jpg
/*.jpeg

# disto_work/ (under datasets/<session>/<set>/) holds the displacement-field
# probe's transient files (converted FITS, warped TIFFs, darktable/siril logs,
# the .ssf). Only the JSON record and the two reproducers are versioned.
**/disto_work/*
!**/disto_work/*.json
!**/disto_work/displacement_field_probe.py
!**/disto_work/warp_ab.sh

# psf_work/ (under datasets/<session>/<set>/) holds the raw-frame PSF-field
# probe's Siril star lists and its .ssf. The .lst files ARE the record.
**/psf_work/*
!**/psf_work/*.lst

# astroreg_work/ — the astrometric-registration probe's sequence files. Only the
# .seq (the registration data it produced) and the .ssf are worth keeping.
**/astroreg_work/*
!**/astroreg_work/*.seq
!**/astroreg_work/*.ssf

# compose_ab/ — the astrometric-vs-star-pair compose A/B. Only the star lists,
# the box coordinates and the .ssf are the record; the stacks are regenerable.
**/compose_ab/*
!**/compose_ab/*.lst
!**/compose_ab/*.ssf
!**/compose_ab/*.txt

# union_ab/ — the 28-member union A/B. Star lists, scripts and box coordinates
# are the record; the unions and registered copies are regenerable.
**/union_ab/*
!**/union_ab/*.lst
!**/union_ab/*.ssf
!**/union_ab/*.txt

# flatdiff_work/ (under datasets/<session>/<set>/) holds the flat-differential
# A/B's Siril star lists, .ssf, psf logs and split channel planes. Only the JSON
# records are versioned; the rest is regenerated by re-running the arms and
# scripts/qa/flat_differential.py.
**/flatdiff_work/*
!**/flatdiff_work/*.json

# pergroup_work/ (under datasets/<session>/<set>/) holds the flat-window arms'
# per-pair Siril working dirs — split channel planes, star lists, .ssf, psf logs
# and the cropped ratio windows. Only the JSON records are versioned; the rest is
# regenerated by re-running the arms, scripts/qa/flat_differential.py,
# scripts/qa/flat_odd_component.py and scripts/qa/grid_ramp.py.
# Records land in pergroup_work/ ITSELF, never in a subdirectory: git does not
# descend into an excluded directory, so a negation inside one cannot re-include
# anything (`!**/pergroup_work/window/*.json` silently matches nothing).
**/pergroup_work/*
!**/pergroup_work/*.json

# tilt_work/ (under datasets/<session>/<set>/) holds the object-tilt instrument's
# Siril star lists, .ssf and psf logs. Only the JSON record is versioned; the
# rest is regenerated by re-running scripts/qa/object_tilt.py.
**/tilt_work/*
!**/tilt_work/*.json
